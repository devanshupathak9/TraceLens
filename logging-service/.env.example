ENVIRONMENT=development
DEBUG=true

# Shared secret the SDK sends as X-API-Key. Leave empty locally to disable the
# check; required in production, where the service refuses to start without it.
INGEST_API_KEY=

# Events kept in memory for /v1/events and /v1/stats. A development aid, not
# storage — see the module docstring in main.py.
BUFFER_SIZE=1000

CORS_ORIGINS=http://localhost:5173
