# SQS queue that events are published to. Without it, ingestion still answers
# 200 but every event is dropped (see the startup log line).
QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/tracelens-events

# Credentials for the send-only publisher IAM user (see DEPLOY.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional — the region is parsed out of QUEUE_URL when unset.
AWS_DEFAULT_REGION=ap-south-1
