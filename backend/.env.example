# --- app ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Comma-separated. The Vite dev server proxies /api, so the browser's origin is
# the dev server itself.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- database -------------------------------------------------------------
# Runtime connection, used by the application.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatjippity

# Migrations and any DDL. Locally this is the same as DATABASE_URL. On Supabase
# it must be the DIRECT connection (port 5432), not the pooler, because DDL and
# advisory locks need a real session.
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:postgres@localhost:5432/chatjippity

# Set true ONLY when DATABASE_URL points at a transaction-mode pooler such as
# Supabase's Supavisor on port 6543. It disables SQLAlchemy's own pooling and
# asyncpg's prepared-statement cache, without which you get
# 'prepared statement "__asyncpg_stmt_1__" already exists' under concurrency.
DB_TRANSACTION_POOLER=false

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-this-is-not-a-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080

# --- llm ------------------------------------------------------------------
# Leave empty to fall back to the echo provider, which streams a canned reply so
# the UI is testable with no key and no spend.
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o
LLM_REQUEST_TIMEOUT_SECONDS=60
MAX_CONTEXT_MESSAGES=10

# --- telemetry ------------------------------------------------------------
# Where the SDK ships inference logs. Unused until the logging service exists.
TRACELENS_INGEST_URL=http://localhost:8001
TRACELENS_API_KEY=
